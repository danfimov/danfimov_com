---
layout: main
---

<header class="pt-2 pb-8 mb-10 border-b border-line dark:border-line-dark">
  <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.1]">{{ title }}</h1>

  <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted dark:text-muted-dark">
    <time class="font-mono">{{ date | postDate }}</time>
    <span aria-hidden="true">&middot;</span>
    <span>{{ content | readTime }} min read</span>
  </div>

  {% set hasTags = false %}
  {% for tag in tags %}{% if tag != "posts" %}{% set hasTags = true %}{% endif %}{% endfor %}
  {% if hasTags %}
  <div class="mt-4 flex flex-wrap">
    {% for tag in tags %}
      {% if tag != "posts" %}
        <a href="/tags/{{ tag }}"><span class="post-tag">{{ tag }}</span></a>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}
</header>

<article class="prose dark:prose-invert max-w-none prose-img:rounded-lg">
  {{ content | safe }}
</article>
