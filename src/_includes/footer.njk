<footer class="mt-16 border-t border-line dark:border-line-dark">
  <div class="w-11/12 max-w-2xl mx-auto py-8 flex items-start gap-4">
    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent dark:bg-accent-dark/15 dark:text-accent-dark font-semibold">DA</div>
    <div>
      <p class="font-semibold">{{ site.name }}</p>
      <p class="mt-1 text-sm text-muted dark:text-muted-dark leading-relaxed">
        Notes on software, the web, and whatever I'm tinkering with.
        Built with 11ty &amp; Tailwind &mdash; works even with JavaScript disabled.
      </p>
      <p class="mt-3 flex gap-4 text-sm">
        {% if site.github != "" %}<a class="text-muted hover:text-accent dark:text-muted-dark dark:hover:text-accent-dark transition-colors" href="{{ site.github }}">GitHub</a>{% endif %}
        {% if site.linkedin != "" %}<a class="text-muted hover:text-accent dark:text-muted-dark dark:hover:text-accent-dark transition-colors" href="{{ site.linkedin }}">LinkedIn</a>{% endif %}
        {% if site.twitter != "" %}<a class="text-muted hover:text-accent dark:text-muted-dark dark:hover:text-accent-dark transition-colors" href="{{ site.twitter }}">Twitter</a>{% endif %}
      </p>
    </div>
  </div>
</footer>
