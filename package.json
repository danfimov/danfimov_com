{
	"private": true,
	"type": "module",
	"scripts": {
		"css": "tailwindcss -i src/_styles/tailwind.css -o src/assets/styles/tailwind.css",
		"css:watch": "tailwindcss -i src/_styles/tailwind.css -o src/assets/styles/tailwind.css --watch",
		"start": "npm run css && concurrently --kill-others --names \"css,11ty\" --prefix-colors \"cyan,magenta\" \"npm:css:watch\" \"eleventy --serve --quiet\"",
		"build": "npm run css && rm -rf _site && eleventy"
	},
	"engines": {
		"node": ">=25"
	},
	"browserslist": [
		"Chrome > 0 and last 2.5 years",
		"ChromeAndroid > 0 and last 2.5 years",
		"Edge > 0 and last 2.5 years",
		"Firefox > 0 and last 2.5 years",
		"FirefoxAndroid > 0 and last 2.5 years",
		"Safari > 0 and last 2.5 years",
		"iOS > 0 and last 2.5 years",
		"not dead"
	],
	"devDependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"@tailwindcss/cli": "^4.1.5",
		"@tailwindcss/typography": "^0.5.20",
		"concurrently": "^9.1.2",
		"js-yaml": "^4.2.0",
		"luxon": "^3.5.0",
		"markdown-it": "^14.1.0",
		"markdown-it-anchor": "^9.2.0",
		"tailwindcss": "^4.1.5"
	}
}
